# ─────────────────────────────────────────────────────────────────────────────
# PTT-Radio — Signaling Server Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
#
# USAGE:
#   cp server/.env.example server/.env
#   Edit server/.env with your values, then start the server.
#
# NOTE:
#   .env.example  -> committed to the repo -- safe template, no secrets
#   .env          -> your local copy -- never committed, lives in .gitignore
# ─────────────────────────────────────────────────────────────────────────────


# -- Network ------------------------------------------------------------------

# Port the signaling server listens on.
# Must match the port your client connects to (ws://host:PORT).
PORT=3001


# -- Room limits --------------------------------------------------------------

# Maximum number of concurrent rooms across the server.
MAX_ROOMS=500

# Maximum number of peers allowed in a single room.
# PTT-Radio supports up to 8 -- raise only if you modify the client cap too.
MAX_PEERS=8


# -- Connection health --------------------------------------------------------

# How often (in milliseconds) the server pings each WebSocket client
# to detect and clean up zombie connections.
HEARTBEAT_MS=20000

# Maximum WebSocket message payload size in bytes.
# 65536 = 64 KB -- signaling messages are tiny; this limit is a safety cap.
MSG_MAX_BYTES=65536


# -- Security -----------------------------------------------------------------

# Comma-separated list of allowed origins for incoming WebSocket connections.
#
# Leave blank during local development to allow all origins:
#   ALLOWED_ORIGINS=
#
# Set to your domain(s) in production to block unauthorized clients:
#   ALLOWED_ORIGINS=https://ptt-radio.your-domain.com
#
# Multiple domains (e.g. www + apex):
#   ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
#
ALLOWED_ORIGINS=
